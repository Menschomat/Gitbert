# ==========================================
# LLM Provider Configuration
# Options: "gemini" (default) or "litellm" (OpenAI-compatible via LiteLLM)
# ==========================================
MODEL_PROVIDER=gemini

# Option 1: Native Google Gemini
# Get an API key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here
MODEL_NAME=gemini-3.8-flash

# Option 2: OpenAI-Compatible / OpenRouter / vLLM (when MODEL_PROVIDER=litellm)
OPENAI_COMPATIBLE_API_KEY=your-openrouter-or-openai-key
OPENAI_COMPATIBLE_MODEL=openrouter/anthropic/claude-3.5-sonnet
OPENAI_COMPATIBLE_API_BASE=https://openrouter.ai/api/v1

# Agent settings
AGENT_NAME=Gitbert
AGENT_DESCRIPTION=Gitbert: The friendly, experienced AI Senior Developer for code reviews.
